#!/bin/sh
### BEGIN INIT INFO
# Provides:          autorun
# Required-Start:    $remote_fs $syslog
# Required-Stop:     $remote_fs $syslog
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Per-VM autorun script from kernel cmdline
### END INIT INFO

set -eu

PIDFILE=/var/run/autorun.pid

get_script() {
  SCRIPT_NAME=""
  for arg in $(cat /proc/cmdline); do
    case "$arg" in
      autorun=*) SCRIPT_NAME="${arg#autorun=}" ;;
    esac
  done
  [ -n "$SCRIPT_NAME" ] || return 1

  case "$SCRIPT_NAME" in
    */*|"") return 1 ;;  # prevent path traversal
  esac

  SCRIPT="/root/${SCRIPT_NAME}"
  [ -x "$SCRIPT" ] || return 1
  echo "$SCRIPT"
}

start() {
  if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
    echo "autorun already running (pid $(cat "$PIDFILE"))."
    return 0
  fi

  if ! SCRIPT="$(get_script)"; then
    echo "autorun: no valid autorun=... script specified."
    return 0
  fi

  echo "Starting autorun: $SCRIPT"
  "$SCRIPT" >/dev/null 2>&1 &
  echo $! > "$PIDFILE"
}

stop() {
  if [ -f "$PIDFILE" ]; then
    PID="$(cat "$PIDFILE")" || true
    if [ -n "${PID:-}" ] && kill -0 "$PID" 2>/dev/null; then
      echo "Stopping autorun (pid $PID)..."
      kill "$PID" 2>/dev/null || true
    fi
    rm -f "$PIDFILE"
  fi
}

status() {
  if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
    echo "autorun running (pid $(cat "$PIDFILE"))."
    exit 0
  fi
  echo "autorun not running."
  exit 3
}

case "${1:-}" in
  start) start ;;
  stop) stop ;;
  restart) stop; start ;;
  status) status ;;
  *) echo "Usage: $0 {start|stop|restart|status}"; exit 2 ;;
esac
